APP_ENV=development
DATABASE_PATH=./data/nextcomply.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# External LLM API configuration (no local Ollama required)
# Set GEMINI_API_KEY (or comma-separated GEMINI_API_KEYS / GEMINI_API_KEY_2..4 for auto-rotation)
# Or set OPENAI_API_KEY (or any OpenAI-compatible LLM_API_KEY + LLM_API_BASE)
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENAI_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=
