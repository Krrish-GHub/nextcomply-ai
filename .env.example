APP_ENV=development
DATABASE_PATH=./data/nextcomply.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# External LLM API configuration (no local Ollama required)
# Set either GEMINI_API_KEY or OPENAI_API_KEY (or any OpenAI-compatible LLM_API_KEY + LLM_API_BASE)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=
